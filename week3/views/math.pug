doctype html
html
    head
        title Simple Calculator

    body
        h1 Calculator

        form(action="/calculate" method="POST")
            input(type="number" name="num1" style="text-align: center; width: 160px; margin-right:3px; font-size:20px;" required )

            select(name="operator" style="font-size: 20px;")
                option(value="+") +
                option(value="-") -

            input(type="number" name="num2" style="text-align: center; width: 160px; margin-left:3px; font-size:20px" required)

            button(type="submit" style="margin-left:3px;") 계산

        if result !== undefined
            h2 결과: #{result}